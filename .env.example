# Backend Environment Configuration Example
# Copy to .env and replace every placeholder before starting the backend.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
ENCRYPTION_KEY=your-fernet-encryption-key
GEMINI_API_KEY=your-google-gemini-api-key
PINECONE_API_KEY=

# Public HTTPS API hostname for Caddy and GitHub webhooks (no scheme or path).
API_DOMAIN=api.example.com
GITHUB_WEBHOOK_BASE_URL=https://api.example.com

# Exact frontend origins, comma-separated; replace with the deployed Vercel origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
REVIEW_RATE_LIMIT_PER_MINUTE=10
REVIEW_WORKER_CONCURRENCY=1
REVIEW_QUEUE_WORKER_ENABLED=true
REVIEW_QUEUE_POLL_SECONDS=1
REVIEW_JOB_LEASE_SECONDS=180
REVIEW_JOB_MAX_ATTEMPTS=3
LLM_REQUESTS_PER_MINUTE=10

# API documentation (keep disabled in production).
ENABLE_API_DOCS=false
