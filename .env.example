# Backend Environment Configuration Example
# Copy to .env and configure with your environment values

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
ENCRYPTION_KEY=your-fernet-encryption-key
GEMINI_API_KEY=your-google-gemini-api-key

# Production CORS allowlist (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
REVIEW_RATE_LIMIT_PER_MINUTE=10

# API Documentation (Disabled by default in production; set to true for local development)
ENABLE_API_DOCS=false
